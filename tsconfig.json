{
  "extends": "primate/tsconfig",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "schemas",
    "scripts",
    "client",
    "config",
    "views",
    "components",
    "routes",
    "stores",
    "locales",
    "templates",
    "static"
  ],
  "exclude": [
    "node_modules"
  ]
}
